{
  "name": "relayops-support-copilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22 <25"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  },
  "scripts": {
    "postinstall": "pnpm db:generate",
    "dev": "pnpm build:packages && concurrently -n api,web -c cyan,magenta \"pnpm --filter @relayops/api dev\" \"pnpm --filter @relayops/web dev\"",
    "dev:api": "pnpm build:packages && pnpm --filter @relayops/api dev",
    "dev:web": "pnpm build:packages && pnpm --filter @relayops/web dev",
    "build:packages": "pnpm --filter @relayops/contracts build && pnpm --filter @relayops/widget build",
    "build": "pnpm build:packages && pnpm --filter @relayops/api build && pnpm --filter @relayops/web build",
    "lint": "eslint .",
    "typecheck": "pnpm build:packages && pnpm --filter @relayops/api typecheck && pnpm --filter @relayops/web typecheck",
    "test": "pnpm build:packages && pnpm --filter @relayops/api test && pnpm --filter @relayops/web test",
    "test:integration": "pnpm build:packages && pnpm --filter @relayops/api test:integration",
    "test:e2e": "pnpm build:packages && pnpm --filter @relayops/web test:e2e",
    "db:generate": "pnpm --filter @relayops/api prisma:generate",
    "db:migrate": "pnpm --filter @relayops/api prisma:migrate",
    "db:deploy": "pnpm --filter @relayops/api prisma:deploy",
    "db:seed": "pnpm --filter @relayops/api prisma:seed",
    "db:reset": "pnpm --filter @relayops/api prisma:reset"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "concurrently": "9.2.0",
    "dotenv-cli": "8.0.0",
    "eslint": "9.32.0",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0"
  }
}
