# Local database values; copy to .env. Never commit credentials.
RELAYOPS_DB_PORT=55432
DATABASE_URL="postgresql://relayops@localhost:55432/relayops?schema=public"
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Explicit generation selection only: disabled (safe default), groq, or ollama.
# Unset is treated as disabled; RelayOps never falls back or routes among providers/models.
RELAYOPS_GENERATION_PROVIDER="disabled"
RELAYOPS_GENERATION_MIN_EVIDENCE_COUNT=1
RELAYOPS_GENERATION_MIN_EVIDENCE_SCORE=0.015

# Optional hosted Groq generation. Keep GROQ_API_KEY only in server process environment
# (for example source ~/.config/relayops/groq.env in an intentional local provider command).
# Fixed server-side endpoint: https://api.groq.com/openai/v1/chat/completions
# Fixed server-side model: openai/gpt-oss-20b. Do not set a URL/model override.
# Set GROQ_API_KEY only in the server process environment; never place it in this file.
RELAYOPS_GROQ_CONNECT_TIMEOUT_MS=5000
RELAYOPS_GROQ_READ_TIMEOUT_MS=19000
RELAYOPS_GROQ_TOTAL_TIMEOUT_MS=24000
RELAYOPS_GROQ_CONCURRENCY=1
RELAYOPS_GROQ_QUEUE=2

# Optional local-development-only Ollama. Select RELAYOPS_GENERATION_PROVIDER="ollama"
# intentionally; the default Compose path never starts it or pulls weights.
RELAYOPS_OLLAMA_BASE_URL="http://127.0.0.1:11435"
RELAYOPS_OLLAMA_MODEL="qwen3:4b"
RELAYOPS_OLLAMA_CONNECT_TIMEOUT_MS=1500
RELAYOPS_OLLAMA_READ_TIMEOUT_MS=22000
RELAYOPS_OLLAMA_CONCURRENCY=1

# Next.js proxies browser /api requests here, keeping the demo cookie same-origin.
RELAYOPS_API_INTERNAL_URL="http://127.0.0.1:3001"
# Optional browser-visible override. Leave unset for the recommended /api proxy.
# NEXT_PUBLIC_RELAYOPS_API_BASE="/api"
