{
  "name": "@relayops/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "build": "nest build",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "lint": "eslint src test prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:integration": "dotenv -e ../../.env -- env RUN_INTEGRATION_TESTS=1 jest --runInBand test/integration.e2e.spec.ts test/knowledge.integration.spec.ts test/account-tools.integration.spec.ts",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:seed": "dotenv -e ../../.env -- prisma db seed",
    "prisma:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "knowledge:ingest": "dotenv -e ../../.env -- ts-node src/knowledge/cli.ts ingest",
    "knowledge:search": "dotenv -e ../../.env -- ts-node src/knowledge/cli.ts search",
    "knowledge:smoke": "dotenv -e ../../.env -- ts-node src/knowledge/cli.ts smoke",
    "knowledge:inspect": "dotenv -e ../../.env -- ts-node src/knowledge/cli.ts inspect",
    "knowledge:evaluate": "dotenv -e ../../.env -- ts-node src/knowledge/cli.ts evaluate",
    "evaluation:deterministic": "dotenv -e ../../.env -- ts-node src/evaluation/cli.ts deterministic",
    "evaluation:integrated": "dotenv -e ../../.env -- ts-node src/evaluation/cli.ts integrated",
    "evaluation:real-model": "dotenv -e ../../.env -- ts-node src/evaluation/cli.ts real-model",
    "evaluation:real-groq": "dotenv -e ../../.env -- ts-node src/evaluation/cli.ts real-groq",
    "evaluation:groq-smoke": "dotenv -e ../../.env -- ts-node src/evaluation/cli.ts groq-smoke",
    "evaluation:groq-regression": "dotenv -e ../../.env -- ts-node src/evaluation/cli.ts groq-regression",
    "evaluation:groq-diagnose": "dotenv -e ../../.env -- ts-node src/evaluation/cli.ts groq-diagnose"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "6.19.3",
    "@huggingface/transformers": "3.8.1",
    "@relayops/contracts": "workspace:*",
    "jszip": "3.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.17.1",
    "jest": "30.4.2",
    "prisma": "6.19.3",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
