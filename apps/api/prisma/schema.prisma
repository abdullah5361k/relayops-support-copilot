generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TradeType {
  HVAC
  PLUMBING
  ELECTRICAL
  REPAIR
}

enum MembershipRole {
  OWNER
  ADMIN
  DISPATCHER
  TECHNICIAN
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum KnowledgeVisibility {
  PUBLIC
  ORGANIZATION
}

enum KnowledgeVersionStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
  SUPERSEDED
}

enum KnowledgeRunStatus {
  RUNNING
  SUCCEEDED
  SKIPPED
  FAILED
}

model User {
  id          String                   @id @default(uuid()) @db.Uuid
  email       String                   @unique
  name        String
  createdAt   DateTime                 @default(now()) @map("created_at")
  memberships OrganizationMembership[]
  technician  Technician?
  openedTickets SupportTicket[]

  @@map("users")
}

model Organization {
  id            String                   @id @default(uuid()) @db.Uuid
  name          String
  slug          String                   @unique
  trade         TradeType
  city          String
  createdAt     DateTime                 @default(now()) @map("created_at")
  memberships   OrganizationMembership[]
  subscription  Subscription?
  customers     Customer[]
  technicians   Technician[]
  jobs          Job[]
  supportTickets SupportTicket[]
  knowledgeSources KnowledgeSource[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  seatLimit     Int            @map("seat_limit")
  monthlyCents  Int            @map("monthly_cents")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @map("organization_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  status         SubscriptionStatus
  startedAt      DateTime           @map("started_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("subscriptions")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  email          String?
  phone          String
  address        String
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs           Job[]
  supportTickets SupportTicket[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("customers")
}

model Technician {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String?      @unique @map("user_id") @db.Uuid
  name           String
  email          String
  specialty      String
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])
  jobs           Job[]

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("technicians")
}

model Job {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  technicianId   String?      @map("technician_id") @db.Uuid
  reference      String
  title          String
  description    String
  status         JobStatus
  scheduledFor   DateTime     @map("scheduled_for")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id])
  technician     Technician?  @relation(fields: [organizationId, technicianId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@map("jobs")
}

model KnowledgeSource {
  id             String              @id @default(uuid()) @db.Uuid
  logicalId      String              @unique @map("logical_id")
  title          String
  visibility     KnowledgeVisibility
  namespace      String
  organizationId String?             @map("organization_id") @db.Uuid
  activeVersionId String?            @unique @map("active_version_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       KnowledgeSourceVersion[] @relation("SourceVersions")
  ingestionRuns  KnowledgeIngestionRun[]
  activeVersion  KnowledgeSourceVersion? @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  @@index([visibility, namespace])
  @@index([organizationId])
  @@map("knowledge_sources")
}

model KnowledgeSourceVersion {
  id              String                 @id @default(uuid()) @db.Uuid
  sourceId        String                 @map("source_id") @db.Uuid
  checksum        String
  parserVersion   String                 @map("parser_version")
  sourceFormat    String                 @map("source_format")
  status          KnowledgeVersionStatus @default(PENDING)
  modelId         String?                @map("model_id")
  modelVersion    String?                @map("model_version")
  error           String?
  createdAt       DateTime               @default(now()) @map("created_at")
  completedAt     DateTime?              @map("completed_at")
  source          KnowledgeSource        @relation("SourceVersions", fields: [sourceId], references: [id], onDelete: Cascade)
  activeForSource KnowledgeSource?       @relation("ActiveVersion")
  chunks          KnowledgeChunk[]
  runs            KnowledgeIngestionRun[]

  @@unique([sourceId, checksum, parserVersion])
  @@index([sourceId, status])
  @@map("knowledge_source_versions")
}

model KnowledgeIngestionRun {
  id          String             @id @default(uuid()) @db.Uuid
  sourceId    String             @map("source_id") @db.Uuid
  versionId   String?            @map("version_id") @db.Uuid
  status      KnowledgeRunStatus @default(RUNNING)
  error       String?
  startedAt   DateTime           @default(now()) @map("started_at")
  finishedAt  DateTime?          @map("finished_at")
  source      KnowledgeSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  version     KnowledgeSourceVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([sourceId, startedAt])
  @@map("knowledge_ingestion_runs")
}

model KnowledgeChunk {
  id          String                 @id @default(uuid()) @db.Uuid
  versionId   String                 @map("version_id") @db.Uuid
  ordinal     Int
  content     String
  heading     String?
  section     String?
  page        Int?
  anchor      String?
  charStart   Int                    @map("char_start")
  charEnd     Int                    @map("char_end")
  tokenCount  Int                    @map("token_count")
  searchText  String                 @map("search_text")
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime               @default(now()) @map("created_at")
  version     KnowledgeSourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, ordinal])
  @@index([versionId])
  @@map("knowledge_chunks")
}

model SupportTicket {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  customerId     String?        @map("customer_id") @db.Uuid
  openedById     String         @map("opened_by_id") @db.Uuid
  reference      String
  subject        String
  body           String
  status         TicketStatus
  priority       TicketPriority @default(NORMAL)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?      @relation(fields: [organizationId, customerId], references: [organizationId, id])
  openedBy       User           @relation(fields: [openedById], references: [id])

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@map("support_tickets")
}
